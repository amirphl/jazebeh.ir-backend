EXTERNAL_SHORTLINK_DATABASE_URL=postgresql://external_shortlink_runtime:CHANGE_ME@127.0.0.1:5433/external_shortlink
EXTERNAL_SHORTLINK_API_TOKEN=GENERATE_AT_LEAST_32_RANDOM_BYTES
EXTERNAL_SHORTLINK_BIND_ADDR=127.0.0.1:8081
EXTERNAL_SHORTLINK_SPOOL_PATH=/var/lib/external-shortlink/click-spool.sqlite3
EXTERNAL_SHORTLINK_POOL_MIN_SIZE=1
EXTERNAL_SHORTLINK_POOL_MAX_SIZE=8
EXTERNAL_SHORTLINK_DB_COMMAND_TIMEOUT_SECONDS=15
EXTERNAL_SHORTLINK_DB_LOCK_TIMEOUT_SECONDS=10
EXTERNAL_SHORTLINK_CLICK_INSERT_TIMEOUT_SECONDS=0.100
EXTERNAL_SHORTLINK_LINK_LOOKUP_TIMEOUT_SECONDS=0.150
EXTERNAL_SHORTLINK_CACHE_MAX_ENTRIES=50000
EXTERNAL_SHORTLINK_CACHE_PRELOAD_ENTRIES=25000
EXTERNAL_SHORTLINK_ADMIN_BATCH_MAX_LINKS=500
EXTERNAL_SHORTLINK_CLICK_FETCH_MAX_LIMIT=2000
EXTERNAL_SHORTLINK_MAX_ADMIN_BODY_BYTES=16777216
EXTERNAL_SHORTLINK_SPOOL_MAX_BYTES=51539607552
EXTERNAL_SHORTLINK_SPOOL_MAX_EVENTS=20000000
EXTERNAL_SHORTLINK_SPOOL_REPLAY_BATCH_SIZE=500
EXTERNAL_SHORTLINK_SPOOL_REPLAY_INTERVAL_SECONDS=1
EXTERNAL_SHORTLINK_SPOOL_OPERATION_TIMEOUT_SECONDS=2
EXTERNAL_SHORTLINK_ACK_RETENTION_DAYS=7
EXTERNAL_SHORTLINK_PURGE_INTERVAL_SECONDS=3600
