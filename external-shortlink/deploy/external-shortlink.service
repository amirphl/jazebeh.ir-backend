[Unit]
Description=External short-link redirect service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=external-shortlink
Group=external-shortlink
WorkingDirectory=/opt/external-shortlink
EnvironmentFile=/etc/external-shortlink.env
Environment=RUST_LOG=info
ExecStart=/opt/external-shortlink/bin/external-shortlink
Restart=on-failure
RestartSec=2s
TimeoutStopSec=30s
KillSignal=SIGTERM
LimitNOFILE=65536

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
ReadWritePaths=/var/lib/external-shortlink
UMask=0027
MemoryHigh=1G
MemoryMax=1536M
TasksMax=256
CPUWeight=200

[Install]
WantedBy=multi-user.target
