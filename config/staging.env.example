APP_ENV=staging
EXTERNAL_SERVICES_MODE=mock
DOMAIN=staging.jazebeh.ir
API_DOMAIN=staging.jazebeh.ir
MONITORING_DOMAIN=staging.jazebeh.ir
SENTRY_UI_DOMAIN=staging.jazebeh.ir
SENTRY_URL_PREFIX=https://staging.jazebeh.ir/sentry
SENTRY_ALLOWED_HOSTS=staging.jazebeh.ir,sentry-beta
PGADMIN_DOMAIN=staging.jazebeh.ir
PGADMIN_LISTEN_BIND_IP=127.0.0.1
PGADMIN_ENV_FILE=/srv/yamata-staging/secrets/pgadmin.env
PGADMIN_DEFAULT_PASSWORD_FILE=/srv/yamata-staging/secrets/pgadmin-password
PGADMIN_NGINX_HTPASSWD_FILE=/srv/yamata-staging/secrets/pgadmin.htpasswd
STAGING_CERT_NAME=jazebeh.ir
DB_PORT=5432
DB_NAME=yamata_staging
DB_USER=yamata_staging
DB_PASSWORD=CHANGE_ME
DB_SSL_MODE=disable
JWT_SECRET_KEY=CHANGE_ME
SENTRY_POSTGRES_DB=glitchtip
SENTRY_POSTGRES_USER=glitchtip
SENTRY_POSTGRES_PASSWORD=CHANGE_ME
SENTRY_GLITCHTIP_SECRET_KEY=CHANGE_ME
SENTRY_SUPERUSER_USERNAME=admin
SENTRY_SUPERUSER_PASSWORD=CHANGE_ME
SENTRY_SUPERUSER_EMAIL=admin@example.test
SENTRY_DEFAULT_FROM_EMAIL=sentry@example.test
SENTRY_EMAIL_URL=consolemail://
SENTRY_ENABLE_USER_REGISTRATION=False
SENTRY_ENABLE_OPEN_USER_REGISTRATION=False
# Convert GlitchTip's public DSN to its container-only endpoint before setting:
# http://<key>@sentry-beta:8000/sentry/<project-id>
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
CERT_ALERT_PHONE=989100000000
BOT_USERNAME=staging-bot
BOT_PASSWORD=CHANGE_ME
# Staging-only mock credentials. Replace before the first deployment; the
# seeder inserts this account only when it does not already exist.
MOCK_SEED_ADMIN_USERNAME=stageadmin
MOCK_SEED_ADMIN_PASSWORD=CHANGE_ME
ADMIN_2FA_MOBILES=
SYSTEM_USER_UUID=11111111-1111-4111-8111-111111111111
TAX_USER_UUID=22222222-2222-4222-8222-222222222222
SYSTEM_WALLET_UUID=33333333-3333-4333-8333-333333333333
TAX_WALLET_UUID=44444444-4444-4444-8444-444444444444
SYSTEM_USER_MOBILE=+989100000000
TAX_USER_MOBILE=+989100000001
SYSTEM_USER_EMAIL=system@example.test
TAX_USER_EMAIL=tax@example.test
SYSTEM_SHEBA_NUMBER=IR000000000000000000000000
CAMPAIGN_EXECUTION_ENABLED=false
SMART_TARGETING_CAPACITY_SCHEDULER_ENABLED=true
SMART_TARGETING_TEST_SAMPLING_SCHEDULER_ENABLED=true
SMART_TARGETING_EXECUTION_CALCULATION_SCHEDULER_ENABLED=true
TAG_TEST_PERFORMANCE_SCHEDULER_ENABLED=true
SMART_TAG_EVALUATION_ENABLED=true
SMART_TAG_EVALUATION_SCHEDULER_ENABLED=true
CRYPTO_ENABLED=true
CACHE_ENABLED=true
CACHE_PROVIDER=redis
CACHE_REDIS_URL=redis://redis-beta:6379
CACHE_REDIS_DB=0
CACHE_REDIS_PREFIX=yamata:
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
TLS_ENABLED=false
LOG_OUTPUT=stdout
METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_ENABLE_PROMETHEUS=true
