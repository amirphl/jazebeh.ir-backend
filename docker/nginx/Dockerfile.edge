# This is a local alias populated by scripts/ensure-openresty-base-image.sh.
# Keeping FROM local prevents BuildKit from waiting on Docker Hub metadata for
# every nginx-related Compose build. The helper pulls this exact upstream
# digest only when the alias is absent.
FROM yamata-openresty-base:1.31.1.1-2-alpine-fat

# OpenResty includes the headers-more module used to remove the Server header.
# Keep the paths expected by the repository's nginx configuration.
RUN mkdir -p /etc/nginx /var/log/nginx \
    && ln -s /usr/local/openresty/nginx/conf/mime.types /etc/nginx/mime.types
